#!/usr/bin/env python3
"""A stand-in for the gh CLI. Answers from JSON files in $FAKE_GH_DIR; fails when $FAKE_GH_DIR/DOWN exists."""
import json, os, sys
d = os.environ["FAKE_GH_DIR"]
if os.path.exists(os.path.join(d, "DOWN")):
    print("could not reach api.github.com", file=sys.stderr); sys.exit(1)
a = sys.argv[1:]
if a[:2] == ["pr", "list"]:
    head = a[a.index("--head") + 1]
    p = os.path.join(d, f"prs-{head}.json")
    print(open(p).read() if os.path.exists(p) else "[]")
elif a[:2] == ["repo", "view"]:
    print(open(os.path.join(d, "repo.json")).read())
else:
    print("fake gh: unknown command", a, file=sys.stderr); sys.exit(2)
