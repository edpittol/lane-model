{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR\"; exec \"${p%%/.claude/worktrees/*}/scripts/lane-hook\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
